{
  "name": "fintheka-studio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "vendor": "node scripts/vendor.cjs",
    "test:browser": "node node_modules/@playwright/test/cli.js test",
    "test:security": "node --test tests/security/*.test.cjs",
    "check:credentials": "node scripts/check-public-credentials.cjs",
    "check:release": "node scripts/check-release.cjs",
    "check:edge-types": "node --use-system-ca scripts/check-edge-types.cjs",
    "start": "node scripts/serve.cjs",
    "check:remote": "node --use-system-ca scripts/check-remote.cjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@playwright/test": "1.65.0",
    "@supabase/supabase-js": "2.119.0",
    "lightweight-charts": "4.2.0"
  }
}
