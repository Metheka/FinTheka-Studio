{
  "name": "fintheka-studio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "vendor": "node scripts/vendor.cjs",
    "prepare:supabase": "node scripts/prepare-supabase.cjs",
    "test:browser": "node node_modules/@playwright/test/cli.js test",
    "test:security": "node --test tests/security/*.test.cjs",
    "check:credentials": "node scripts/check-public-credentials.cjs",
    "check:release": "node scripts/check-release.cjs",
    "check:edge-types": "node --use-system-ca scripts/check-edge-types.cjs",
    "start": "node scripts/serve.cjs",
    "start:remote": "node scripts/serve.cjs --remote",
    "start:local": "node scripts/serve.cjs --local",
    "local:backup": "node scripts/local-admin.cjs backup",
    "local:restore": "node scripts/local-admin.cjs restore",
    "local:password": "node scripts/local-admin.cjs password",
    "check:local": "node scripts/check-release.cjs --local",
    "check:remote": "node --use-system-ca scripts/check-remote.cjs"
  },
  "engines": { "node": ">=24" },
  "dependencies": {
    "@electric-sql/pglite": "0.5.16"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@supabase/supabase-js": "2.119.0",
    "lightweight-charts": "4.2.0"
  }
}
